diff --git a/cmake/dxrt.function.cmake b/cmake/dxrt.function.cmake
index 653f937..8f29fa7 100644
--- a/cmake/dxrt.function.cmake
+++ b/cmake/dxrt.function.cmake
@@ -57,5 +57,4 @@ macro(add_target target)
     add_executable(${target} ${ARG_SRC_LIST})
     add_dxrt(${target})
     install(TARGETS ${target} DESTINATION bin)
-    install(TARGETS ${target} DESTINATION ${CMAKE_SOURCE_DIR}/bin)
 endmacro(add_target)
diff --git a/examples/display_async_pipe/CMakeLists.txt b/examples/display_async_pipe/CMakeLists.txt
index 21517ac..c03530b 100644
--- a/examples/display_async_pipe/CMakeLists.txt
+++ b/examples/display_async_pipe/CMakeLists.txt
@@ -6,4 +6,3 @@ add_executable(${target} ${srcs})
 target_include_directories(${target} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)  
 add_dxrt(${target})
 install( TARGETS ${target} DESTINATION bin/examples )
-install( TARGETS ${target} DESTINATION ${CMAKE_SOURCE_DIR}/bin/examples )
\ No newline at end of file
